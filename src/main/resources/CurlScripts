User API's

Get All USers
curl --location 'http://localhost:8080/api/users'

Add User
curl --location 'http://localhost:8080/api/users' \
--header 'Content-Type: application/json' \
--data-raw '{
    "firstName":"Vishwas",
    "lastName":"B C",
    "email":"vishu@gmail.com",
    "phNo":"9482445422",
    "address":{
        "street":"1st Main,3rd Cross,Gandhinagara",
        "city":"Mandya",
        "state":"Karnataka",
        "country":"India",
        "zipCode":"571401"
    }
}'

Get User
curl --location 'http://localhost:8080/api/users/1'

Update User
curl --location --request PUT 'http://localhost:8080/api/users/1' \
--header 'Content-Type: application/json' \
--data-raw '{
    "firstName":"Vishwas",
    "lastName":"B C",
    "email":"vishwas@gmail.com",
    "phNo":"9482445422",
    "address":{
        "street":"1st Main,3rd Cross,Gandhinagara",
        "city":"Mysore",
        "state":"Karnataka",
        "country":"India",
        "zipCode":"571401"
    }
}'

Product API's

Add Product
curl --location 'http://localhost:8080/api/products' \
--header 'Content-Type: application/json' \
--data '{
    "name":"Iphone Pro",
    "description":"The Latest Iphone Pro with amazing features",
    "price":"1099.99",
    "stockQuantity":"10",
    "category":"Electronics",
    "imageUrl":"http://placeholder.co/1920x1080"
}'

Update Product
curl --location --request PUT 'http://localhost:8080/api/products/1' \
--header 'Content-Type: application/json' \
--data '{
    "name":"Iphone 17 Pro",
    "description":"The Latest Apple Iphonewith amazing features",
    "price":"1999.99",
    "stockQuantity":"50",
    "category":"Electronics",
    "imageUrl":"http://placeholder.co/1920x1080"
}'

Get All Products
curl --location 'http://localhost:8080/api/products' \
--data ''

Delete Product
curl --location --request DELETE 'http://localhost:8080/api/products/1'

Search Product
curl --location 'http://localhost:8080/api/products?keyword=Pro' \
--data ''

